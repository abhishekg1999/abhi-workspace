######################################
calulate the pll and divider

note: IMX PLL range is 600MHz to 1300MHz

## for 51Mhz Pixel clock : 

Pixel clock = 51 MHz
Choose integer divider = 20
PLL frequency = 51 × 20 = 1020 MHz

now we can calculate for driver :

Fout = Fin x (mdiv+kdiv/65536)
	     _________________
	      pdiv x 2^sdiv
	      
	​
We have:
Fout = 1020
Fin = 24

assume:
pdiv = 3
sdiv =1

solve:

1020 = 24 x (mdiv+kdiv/65536)
	     _________________
	      3 x 2^1
	      
mdiv + kdiv​  = 1020 x 3 x 2^1
       ____    ______________
       65536	     24

mdiv + kdiv​  = 255
       ____   
       65536	  
       
now => split and compare for mdiv amd kdiv

mdiv + kdiv​  = 255 + 0
       ____   
       65536	
       
so now  
mdiv = 255
kdiv = 0


confirm by values:

Fout = 24 x (255+0)
	    ________   = 1020 
	     3 x 2^1

final parameters:

mdiv = 255
kdiv = 0
pdiv = 3
sdiv = 1

PLL_1443X_RATE(rate, mdiv, pdiv, sdiv, kdiv)
PLL_1443X_RATE(1020000000U, 255, 3, 1, 0)  //for 51Mhz

in dts:
assigned-clock-rates = <1020000000>, <1020000000>, <51000000>;

## for 71MHz:

Pixel clock = 71 MHz
Choose integer divider = 14
PLL frequency = 71 × 14 = 994 MHz

now we can calculate for driver :

Fout = Fin x (mdiv+kdiv/65536)
	     _________________
	      pdiv x 2^sdiv
	      
	​
We have:
Fout = 1020
Fin = 24

assume:
pdiv = 3
sdiv =1

solve:

994 = 24 x (mdiv+kdiv/65536)
	     _________________
	      3 x 2^1
	      
mdiv + kdiv​  = 994 x 3 x 2^1
       ____    ______________
       65536	     24

mdiv + kdiv​  = 248.5
       ____   
       65536	  
       
now => split and compare for mdiv amd kdiv

mdiv + kdiv​  = 248 + 0.5
       ____   
       65536	
       
kdiv = 0.5 x 65536 = 32768
       
so now  
mdiv = 248
kdiv = 32768


confirm by values:

Fout = 24 x (248+32768)
	    ________   = 994 
	     3 x 2^1

final parameters:

mdiv = 248
kdiv = 32768
pdiv = 3
sdiv = 1

PLL_1443X_RATE(rate, mdiv, pdiv, sdiv, kdiv)
PLL_1443X_RATE(994000000U, 248, 3, 1, 32768)  //for 71Mhz

in dts:
assigned-clock-rates = <994000000>, <994000000>, <71000000>;

