Q10 value = raw 32-bit value	= raw value
	   ----------------	  ---------
	   	2^10		      1024
	​

	​
char* CANIn_tcu1mc3_wrpara_reg21_status(void)
{
    static char buf[256];
    uint32_t value = 0;
    double q10_value = 0.0;
    status_code_t fault = STATUS_SUCCESS;

    if (reg_read(0xA3106000, 0xD54, &value) != 0) {
        value = 0;
        fault = STATUS_ERR_HW_FAILED;
    }

    q10_value = (double)value / 1024.0;

    snprintf(buf, sizeof(buf),
             "{ \"id\": 21, \"status\": %d, \"value\": %.3f }",
             fault, q10_value);

    return buf;
}

