#include <stdint.h>

// Define the single green LED pin for the Nucleo board
#define LED_GREEN   5

// Function declarations
void led_init_all(void);
void led_on(uint8_t led_no);
void led_off(uint8_t led_no);
void simple_delay(volatile uint32_t count);


int main(void)
{
    // 1. Initialize the GPIOA Pin 5 register settings
    led_init_all();

    // 2. Infinite test loop
    while(1)
    {
        led_on(LED_GREEN);
        simple_delay(500000); // Keep LED on for a moment

        led_off(LED_GREEN);
        simple_delay(500000); // Keep LED off for a moment
    }

}

void led_init_all(void)
{
    uint32_t *pRccAhb1enr = (uint32_t*)0x40023830;
    uint32_t *pGpioaModeReg = (uint32_t*)0x40020000;

    *pRccAhb1enr |= (1 << 0);                 // Enable Port A clock
    *pGpioaModeReg &= ~(3 << (2 * LED_GREEN)); // Clear existing bits for Pin 5
    *pGpioaModeReg |= (1 << (2 * LED_GREEN));  // Set Pin 5 as Output (01)

    led_off(LED_GREEN);
}

void led_on(uint8_t led_no)
{
    uint32_t *pGpioaDataReg = (uint32_t*)0x40020014;
    *pGpioaDataReg |= (1 << led_no);
}

void led_off(uint8_t led_no)
{
    uint32_t *pGpioaDataReg = (uint32_t*)0x40020014;
    *pGpioaDataReg &= ~(1 << led_no);
}

// Simple software delay loop since FreeRTOS osDelay() is not running yet
void simple_delay(volatile uint32_t count)
{
    while(count > 0)
    {
        count--;
    }
}
