/**
WAP to execute an SVC instruction from thread  mode , impliment the SVC handler to print the SVC number used,
also increment the SVC number by 4 and return it to the thread mode code and print it.

 */

#include <stdio.h>
#include <stdint.h>

#if !defined(__SOFT_FP__) && defined(__ARM_FP)
  #warning "FPU is not initialized, but the project is compiling for an FPU. Please initialize the FPU before use."
#endif

void SVC_Handler_c(uint32_t *pBaseOFStackFrame){

	uint32_t arg0, arg1;
	printf("In SVC_Handler\n");
	uint8_t *pReturn_addr = (uint8_t*)pBaseOFStackFrame[6];

	//decrement the return address by 2 to print to opcode of the SVC instruction in the program memory
	pReturn_addr -=2;
	uint8_t svc_number = *pReturn_addr;
	printf("SVC number is : %d\n", svc_number);

	arg0 = pBaseOFStackFrame[0]; //store r0 to arg0
	arg1 = pBaseOFStackFrame[1]; //store r1 to arg1

	switch(svc_number) {

	case 36:
		res = arg0 + arg1;
		break;
	case 37:
		res = arg0 - arg1;
		break;
	case 38:
		res = arg0 * arg1;
		break;
	case 39:
		res = arg0 / arg1;
		break;
	default:
		printf("Invalid svc code\n");
	}

	pBaseOFStackFrame[0] = res;

}

uint32_t add_numbers(uint32_t x, uint32_t y) {

	uint32_t res;
	__asm volatile("SVC #36");
	 __asm ("MOV %0, R0": "=r"(res) ::);
	 return res;
}

uint32_t sub_numbers(uint32_t x, uint32_t y) {

	uint32_t res;
	__asm volatile("SVC #37");
	 __asm ("MOV %0, R0": "=r"(res) ::);
	 return res;
}
uint32_t mul_numbers(uint32_t x, uint32_t y) {

	uint32_t res;
	__asm volatile("SVC #38");
	 __asm ("MOV %0, R0": "=r"(res) ::);
	 return res;
}
uint32_t div_numbers(uint32_t x, uint32_t y) {

	uint32_t res;
	__asm volatile("SVC #39");
	 __asm ("MOV %0, R0": "=r"(res) ::);
	 return res;
}

int main(void)
{
	uint32_t res;
	res = add_numbers(40, -90);
	printf("add res = %ld\n", res);

	for(;;);
}

__attribute ((naked)) void SVC_Handler (void){
	__asm ("MRS R0, MSP");
	__asm ("B SVC_Handler_c");
}
