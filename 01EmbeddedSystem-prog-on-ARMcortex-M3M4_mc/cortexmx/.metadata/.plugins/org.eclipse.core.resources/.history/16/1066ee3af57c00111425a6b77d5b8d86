void init_systick_timer(uint32_t tick_hz) {

	uint32_t *pSRVR = (uint32_t*)0xE000E014;  //SysTick reload value register
	uint32_t *pSCSR = (uint32_t*)0xE000E010;  //SysTick control and status register

	uint32_t count_value = (SYSTICK_TIM_CLK/tick_hz)-1;

	//clear the value of SVR
	*pSRVR &= ~(0x00FFFFFF);

	//load the value into SVR
	*pSRVR |= count_value;

	//settings
	*pSCSR |= (1<<1);  //enable systick exception request
	*pSCSR |= (1<<2);  //set processor clock to systick

	//enable systick
	*pSCSR |= (1<<0);  //enable the systick

}

void init_task_stack(void) {

	uint32_t *pPSP;
	for(int i=0; i<MAX_TASK; i++){

		/* xPSR */
		pPSP--;
		*pPSP = 0x01000000;  //dummy xPSR

		/* PC */
		pPSP--;
		*pPSP = task_handlers[i];  //load pc with task handler

		/* LR */
		pPSP--;
		*pPSP = 0xFFFFFFFD;

		/* r0 to r13 */
		for(int j=0; i<13; j++) {

			pPSP--;
			*pPSP = 0;
		}

		psp_of_tasks[i] = (uint32_t)pPSP;
	}

}

