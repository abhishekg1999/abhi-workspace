#include <stdint.h>
#include <stdio.h>


int fun_divide(int x, int y) {
	return x/y;
}

int main(void)
{
    //1. enable all the configurable exceptions like usage fault, mem manage fault and bus fault
	uint32_t *pSHCSR = (uint32_t*)0xE000ED24;

	*pSHCSR |= (1<<16); // mem fault
	*pSHCSR |= (1<<17); // bus fault
	*pSHCSR |= (1<<18); // usage fault

	//2. enable divide by zero trap
	uint32_t *pCCR = (uint32_t*)0xE000ED14;
	*pCCR |= (1<<4);

	fun_divide(10,0);

	for(;;);
}

